# ============================================================
# TensorFlow and Keras artifacts
# ============================================================
# Uncomment if generated model checkpoints should not be tracked.
# models/*.keras
# models/*.h5
# models/checkpoints/

# TensorBoard logs
runs/
tensorboard/
events.out.tfevents.*

# ============================================================
# Generated datasets
# ============================================================
# Uncomment these if datasets are large or reproducible.
# data/raw/*
# data/interim/*
# data/processed/*

# ============================================================
# Generated reports and experiment outputs
# ============================================================
# Uncomment if these files are reproducible and need not be versioned.
# reports/figures/*.png
# reports/evaluation_metrics.json
# models/training_history.csv

# Generated datasets
data/raw/*
data/interim/*
data/processed/*

# Keep directory placeholders
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Trained models and generated metadata
models/*.keras
models/*.h5
models/model_metadata.json
models/training_history.csv

# Generated evaluation outputs
reports/evaluation_metrics.json
reports/figures/*.png